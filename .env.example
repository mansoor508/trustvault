# ===========================================================================
# TrustVault - environment variable template (SAFE TO COMMIT)
# ===========================================================================
# Copy this file to `.env` in the repository root, then edit the values:
#
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env
#
# `.env` is git-ignored. Never commit the filled-in copy, never paste real
# secrets into README, docs, screenshots, chat or the PROMPTS.md log.
#
# Generate a real session secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# The server loads environment files in this order (first value wins):
#   1. real process environment variables (host / CI / Vercel / Render)
#   2. server/.env
#   3. .env  (this file, copied - repository root)
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Express "trust proxy" hop count. Set to 1 when running behind a single
# reverse proxy / load balancer (Render, Railway, nginx). Keep 0 locally.
TRUST_PROXY=0

# --- Browser origin allow-list (CORS) --------------------------------------
# Comma-separated, exact origins, no trailing slash, no wildcards.
# Development: the Vite dev server.
CLIENT_ORIGINS=http://localhost:5173
# Production example:
# CLIENT_ORIGINS=https://trustvault-app-1i2l.onrender.com,https://trustvault-app.onrender.com

# --- Sessions --------------------------------------------------------------
# MUST be at least 32 characters of high-entropy randomness.
# The placeholder below is rejected when NODE_ENV=production.
SESSION_SECRET=dev-only-placeholder-session-secret-change-me-0001
SESSION_COOKIE_NAME=tv_session
SESSION_TTL_HOURS=12

# --- MySQL -----------------------------------------------------------------
# Create the database and a dedicated least-privilege user first:
#   mysql -u root -p < database/bootstrap.sql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=trustvault
DATABASE_PASSWORD=
DATABASE_NAME=trustvault
DATABASE_CONNECTION_LIMIT=10
# Set to "true" for TiDB Cloud / cloud MySQL databases requiring TLS/SSL:
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Private file storage --------------------------------------------------
# Relative paths resolve from the `server/` directory. Must stay outside
# `client/` and outside version control.
STORAGE_DIR=./storage
# Per-file ceiling for document uploads (default 10 MiB). Content validation
# accepts PDF, PNG, JPG, DOCX, XLSX, PPTX, TXT, MD and CSV.
MAX_UPLOAD_BYTES=10485760

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ===========================================================================
# Day 2 - authentication and session hardening
# ===========================================================================

# --- Session lifetime ------------------------------------------------------
# Absolute lifetime (hours) stays in SESSION_TTL_HOURS above. This is the
# inactivity timeout: a session unused for this long is rejected.
SESSION_IDLE_MINUTES=60
# lax | strict | none. Use "none" only when the SPA and the API live on
# different sites; browsers require HTTPS plus a Secure cookie for it.
SESSION_COOKIE_SAME_SITE=lax

# --- Password hashing ------------------------------------------------------
# bcrypt work factor. 12 is a sensible default for 2026 hardware.
BCRYPT_COST=12

# --- Login throttling and account lockout ---------------------------------
# Failed attempts for one account before a temporary lock.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Requests allowed per (IP + email) pair inside the window below. This runs
# before bcrypt, so brute force costs the attacker rather than the server.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Demo seed (optional, operator-invoked only) ---------------------------
# If unset, `npm run seed` generates strong random passwords and prints them
# once. Never reuse demo credentials outside a local demo.
# SEED_ADMIN_PASSWORD=
# SEED_OWNER_PASSWORD=
# SEED_VIEWER_PASSWORD=

# --- Employee Invitation & Transactional Email (Gmail SMTP / Resend) -------
# Option A: Gmail SMTP (Recommended - zero domain setup needed)
# Generate a 16-character Google App Password:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an app password for "TrustVault"
# 4. Fill in SMTP_USER and SMTP_PASS below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=abcdefghijklmnop
# MAIL_FROM=TrustVault <your-account@gmail.com>

# Option B: Resend (Alternative transactional email provider)
# Get your free API key at https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key_here
# INVITATION_FROM_EMAIL=TrustVault <onboarding@resend.dev>

# Frontend base URL for the invitation acceptance link (defaults to first entry in CLIENT_ORIGINS)
# FRONTEND_URL=https://trustvault-app-1i2l.onrender.com
