{
  "name": "@trustvault/server",
  "version": "0.1.0",
  "private": true,
  "description": "TrustVault API - Express + TypeScript + MySQL",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/scripts/migrate.ts up",
    "migrate:status": "tsx src/scripts/migrate.ts status",
    "migrate:dry": "tsx src/scripts/migrate.ts up --dry-run",
    "seed": "tsx src/scripts/seed.ts",
    "promote:platform-admin": "tsx src/scripts/promote-platform-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
